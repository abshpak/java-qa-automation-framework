# Default: normalize text files to LF in repo and working tree
* text=auto eol=lf

# Windows scripts must keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Unix scripts must keep LF (explicit for clarity)
mvnw  text eol=lf
*.sh  text eol=lf

# Binaries: never touch
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary