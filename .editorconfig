root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf

[*.{yml,yaml}]
indent_size = 2

[*.java]
ij_java_method_call_chain_wrap = normal
ij_java_align_multiline_chained_methods = false
ij_java_keep_line_breaks = true
ij_continuation_indent_size = 8